# Production env values — copy to server /opt/ops-desk/.env and fill.
# NEVER commit the filled file. See docs/04-infrastructure/deploy-info.local.md.

# Required
DB_PASSWORD=
OPS_DESK_SECRET=          # openssl rand -hex 32

# LLM
SILICONFLOW_API_KEY=
BAILIAN_API_KEY=
OPS_LLM_PROVIDER=siliconflow

# Security / behavior
OPS_CHAT_WS_ENABLED=false          # keep false: unauthenticated demo endpoint
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://www.cynaya.cn

# One-time data import (only needed for the initial Supabase import; can stay blank afterwards)
SUPABASE_DATABASE_URL=
