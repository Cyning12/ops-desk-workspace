# 生产环境变量 — 复制到服务器 /opt/ops-desk/.env 后填值。禁止提交填好的文件。
# 用法：docker compose -f docker-compose.prod.yml --env-file /opt/ops-desk/.env …
#
# 容器只吃 docker-compose.prod.yml → api.environment 声明过的键。
# 本文件与 compose 透传应对齐；应用侧全集注释见 ops-desk-api/.env.example。

# --- 必填 ---
DB_PASSWORD=
OPS_DESK_SECRET=
# openssl rand -hex 32

# --- LLM ---
OPS_LLM_PROVIDER=siliconflow
OPS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# --- 安全 / 站点 ---
OPS_CHAT_WS_ENABLED=false
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://www.cynaya.cn
# ⚠️ 这条**改了没用**：compose 里 `OPS_DESK_AUTH_MODE: db` 是**硬编码**的，不走 ${} 透传。
#    要改得同时改 docker-compose.prod.yml。保留在此仅为记录当前值。
OPS_DESK_AUTH_MODE=db
# 机读 Bearer（POST /api/ops/admin/sync、/hitl/* 管理端点）。空=禁用 Bearer 路径
OPS_ADMIN_SYNC_TOKEN=

# --- RAG / Qdrant（现网切读后） ---
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_SHADOW_WRITE=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ops_knowledge
# 查询期 HNSW ef（须 compose api.environment 透传；默认 30）
QDRANT_HNSW_EF=30
RAG_FTS_CONFIG=simple
RAG_KW_EXPAND=false
# siliconflow=远程 POST /embeddings（默认）；local=本机 SentenceTransformer（仅本机有内存时）
RAG_EMBED_BACKEND=siliconflow
# RAG_EMBED_MODEL=BAAI/bge-m3
RAG_RERANK_ENABLED=true
# siliconflow=远程 POST /rerank（默认）；local=本机 CrossEncoder（仅本机有内存时）
RAG_RERANK_BACKEND=siliconflow
RAG_RERANK_MIN_SCORE=0.4
RAG_RERANK_SCORE_RATIO=0.75
RAG_GRADER_PROMPT=v1
RAG_GRADER_PROVIDER=bailian
RAG_GRADER_MODEL=qwen3.7-flash
# LC Evidence 问答（留空=跟随 grader/默认）
RAG_LC_ANSWER_PROVIDER=
RAG_LC_ANSWER_MODEL=

# --- HuggingFace（腾讯云访问不了 huggingface.co；须 compose 透传） ---
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0

# --- Langfuse（可选） ---
# OPS_CHAT_TRACER=langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 默认 prod；本机调试写 dev（须与 UI 顶栏 Environment 一致）
# LANGFUSE_ENV=prod

# --- Capability 治理 · HITL 审批 · 图挂起点（2026-09-21 补） ---
# ⚠️ 纪律：**.env 与 docker-compose.prod.yml 的 api.environment 必须成对改**。
#    只写这里不加 compose 透传 = 值进了服务器，但容器里看不到。
#    改完 reload 方式见 docs/04-infrastructure/02-prod-env-reload.md。

# 防重与回执落库。空=null（不落库，**不可上生产**）| memory | db
OPS_CAPABILITY_PERSISTENCE=db

# 额外能力清单：**必须显式列出**（禁止目录扫描）。容器内是 /app/app/ops/...
OPS_CAPABILITY_EXTRA_MANIFESTS=/app/app/ops/capability/manifests/oa.readonly.v1.yaml

# 运维停用闸：逗号分隔的匹配模式（**不是布尔**）。空=不停用；`*`=全部停用；`oa.ticket.*`=停该前缀
OPS_CAPABILITY_KILL_SWITCH=

# 熔断状态后端：memory（单实例，推荐）| redis（多实例，需同时给 URL）
# 代码默认的 mock-unavailable 是刻意让存储不可用的**测试**模式，生产别沿用
OPS_CAPABILITY_CB_BACKEND=memory
OPS_CAPABILITY_CB_REDIS_URL=

# OA 网关基址与凭证值（清单里只写凭证名 oa_gateway_token，值在这里）
# 凭证必须与 OA 侧校验的 token 一致，否则该能力恒 permission_denied
OA_BASE=
OPS_CAP_CRED_OA_GATEWAY_TOKEN=

# HITL 审批：申请落库 + 回调签名密钥
# **密钥为空 = 回调端点拒绝一切请求**（不设密钥=不开放）；须与 OA 侧配置一致
OPS_HITL_PERSISTENCE=db
OPS_HITL_CALLBACK_SECRET=

# 图挂起点：只有 postgres 才跨请求可恢复（空=内存 saver，恢复端点会 503）
LG_RAG_HTTP_CHECKPOINTER=postgres

# --- 一次性导入，完成后可留空 ---
SUPABASE_DATABASE_URL=
